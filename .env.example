# Ключ Claude API (console.anthropic.com). Без ключа Акыл работает в офлайн-режиме на шаблонах.
ANTHROPIC_API_KEY=

# Модель (по умолчанию claude-opus-5-5). Для экономии на скриншотах можно поставить claude-haiku-5-5.
# NAZAR_MODEL=claude-opus-5-5

# Зрение (анализ скриншотов) по умолчанию выключено. on включает его сразу при запуске. Можно включить и в окне старта или в трее.
# NAZAR_VISION=on
# NAZAR_VISION_INTERVAL_SEC=45

# Через сколько секунд отвлечения Акыл вмешивается (для демо удобно 5–10).
# NAZAR_DRIFT_SEC=20
